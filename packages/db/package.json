{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./client": "./src/client.ts",
    "./password": "./src/password.ts"
  },
  "scripts": {
    "local": "node --env-file-if-exists=../../.env --import tsx src/local-server.ts",
    "generate": "drizzle-kit generate",
    "migrate": "node --env-file-if-exists=../../.env --import tsx src/migrate.ts",
    "seed": "node --env-file-if-exists=../../.env --import tsx src/seed/index.ts",
    "reset": "node --env-file-if-exists=../../.env --import tsx src/migrate.ts && node --env-file-if-exists=../../.env --import tsx src/seed/index.ts",
    "placeholders": "node --import tsx scripts/generate-placeholders.ts",
    "studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@repo/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "postgres": "4.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@electric-sql/pglite-socket": "0.2.19",
    "drizzle-kit": "0.31.11",
    "sharp": "0.35.5",
    "tsx": "4.23.15"
  }
}
