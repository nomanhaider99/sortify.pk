# Postgres connection (Neon in production).
# Local dev without Postgres: run `pnpm db:local` (PGlite server) and use the URL below.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres

# Storefront
NEXT_PUBLIC_SITE_URL=http://localhost:3000
REVALIDATE_SECRET=change-me-long-random-string

# Admin
AUTH_SECRET=
AUTH_URL=http://localhost:3001
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=ChangeMe!123
STOREFRONT_URL=http://localhost:3000
# Public storefront origin for links/images in the admin UI (runtime; defaults to STOREFRONT_URL)
STOREFRONT_PUBLIC_URL=http://localhost:3000

# Uploads
CLOUDINARY_URL=

# Email (optional)
RESEND_API_KEY=
MAIL_FROM=
